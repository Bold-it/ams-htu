app.get('/api/users', async (req, res) => {
    try {
        const userEmail = req.headers['x-user-email'];
        const [userRows] = await pool.query('SELECT role FROM users WHERE email = ?', [userEmail]);

        if (userRows.length === 0 || userRows[0].role !== 'super_admin') {
